node_modules/
dist/
*.tsbuildinfo

# ctxd never indexes secrets; never commit them either.
.env
.env.*

.DS_Store
.claude

# Built interface bundle
packages/ui/dist/

# Rust build artefacts for the desktop shell. Cargo.lock is committed: the
# shell is a binary, and a binary that resolves different dependency versions
# per machine is a binary nobody can reproduce.
packages/desktop/target/

# Tauri writes these permission schemas on every build from the crate's own
# dependencies. Committing them would mean a diff whenever Tauri updates,
# describing nothing this project decided.
packages/desktop/gen/

# The desktop app's bundled runtime and application, assembled by
# scripts/stage-desktop.ts on the machine doing the build. Platform-specific
# and ~100MB; rebuilt, never committed.
packages/desktop/sidecar/
