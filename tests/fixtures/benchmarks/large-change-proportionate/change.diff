-import Stripe from "stripe";
+import { StripeClient } from "../stripe/client.js";
 import type { ChargeRequest, ChargeResult } from "./types.js";

-const stripe = new Stripe(process.env.STRIPE_KEY ?? "");
+const client = new StripeClient();

 export async function createCharge(request: ChargeRequest): Promise<ChargeResult> {
-  const intent = await stripe.paymentIntents.create({
-    amount: request.amountCents,
-    currency: request.currency,
-    customer: request.customerId,
-  });
+  const intent = await client.createPaymentIntent({
+    amountCents: request.amountCents,
+    currency: request.currency,
+    customerId: request.customerId,
+    idempotencyKey: request.idempotencyKey,
+  });

-  if (intent.status === "requires_payment_method") {
-    return { ok: false, reason: "no payment method" };
+  if (intent.status === "requires_payment_method") {
+    return { ok: false, reason: "no payment method", intentId: intent.id };
   }

-  return { ok: true, intentId: intent.id };
+  return { ok: true, intentId: intent.id, status: intent.status };
 }
+
+export async function capture(intentId: string): Promise<ChargeResult> {
+  const captured = await client.capturePaymentIntent(intentId);
+  return { ok: captured.status === "succeeded", intentId, status: captured.status };
+}
diff --git a/src/payment/refund.ts b/src/payment/refund.ts
index b2c3d4e..e5f6a7b 100644
--- a/src/payment/refund.ts
+++ b/src/payment/refund.ts
@@ -1,18 +1,21 @@
-import Stripe from "stripe";
+import { StripeClient } from "../stripe/client.js";
 import type { RefundRequest, RefundResult } from "./types.js";

-const stripe = new Stripe(process.env.STRIPE_KEY ?? "");
+const client = new StripeClient();

 export async function refundCharge(request: RefundRequest): Promise<RefundResult> {
-  const refund = await stripe.refunds.create({
-    payment_intent: request.intentId,
-    amount: request.amountCents,
-  });
+  const refund = await client.createRefund({
+    intentId: request.intentId,
+    amountCents: request.amountCents,
+    idempotencyKey: request.idempotencyKey,
+  });

-  return { ok: refund.status === "succeeded", refundId: refund.id };
+  if (refund.status === "pending") {
+    return { ok: false, refundId: refund.id, pending: true };
+  }
+
+  return { ok: refund.status === "succeeded", refundId: refund.id, pending: false };
 }
