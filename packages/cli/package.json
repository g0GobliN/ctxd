{
  "name": "@ctxd/cli",
  "version": "0.1.2",
  "description": "A context firewall for AI coding agents — local-first engineering memory",
  "keywords": [
    "ai",
    "llm",
    "context",
    "claude",
    "cursor",
    "mcp",
    "tokens",
    "agent",
    "code-review",
    "local-first"
  ],
  "license": "MIT",
  "author": "the ctxd authors",
  "homepage": "https://github.com/g0GobliN/ctxd#readme",
  "bugs": {
    "url": "https://github.com/g0GobliN/ctxd/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g0GobliN/ctxd.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "ctxd": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ctxd/ai": "workspace:*",
    "@ctxd/api": "workspace:*",
    "@ctxd/context": "workspace:*",
    "@ctxd/core": "workspace:*",
    "@ctxd/db": "workspace:*",
    "@ctxd/events": "workspace:*",
    "@ctxd/diff": "workspace:*",
    "@ctxd/firewall": "workspace:*",
    "@ctxd/mcp": "workspace:*",
    "@ctxd/memory": "workspace:*",
    "@ctxd/project": "workspace:*",
    "@ctxd/stats": "workspace:*",
    "@ctxd/utils": "workspace:*",
    "@ctxd/verify": "workspace:*",
    "@ctxd/work": "workspace:*"
  }
}
